#!/usr/bin/env bash
# Run the standalone fixture; --behave/--unittest/--latency isolate suites for CI.
set -euo pipefail

refuse() {
    printf '%s\n' 'Refusing external configuration; use only the standalone test fixture.' >&2
    exit 2
}

failure=0
auth_only=0
suite=combined
if [[ $# == 1 && $1 == --verify-cleanup ]]; then
    failure=1
elif [[ $# == 1 && $1 == --auth ]]; then
    auth_only=1
elif [[ $# == 1 && $1 == --sessions ]]; then
    auth_only=2
elif [[ $# == 1 && $1 == --behave ]]; then
    suite=behave
elif [[ $# == 1 && $1 == --unittest ]]; then
    suite=unittest
elif [[ $# == 1 && $1 == --latency ]]; then
    suite=latency
elif [[ $# != 0 ]]; then
    refuse
fi
for key in ${!COMPOSE_@} DATABASE_URL JWT_SECRET GEMINI_API_KEY GEMINI_MODEL GOOGLE_API_KEY DOCKER_HOST DOCKER_CONTEXT; do
    [[ ! -v $key ]] || refuse
done

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
project=typr-test-$(tr -d '-' </proc/sys/kernel/random/uuid)
compose=(docker --context default compose --env-file /dev/null --project-directory "$root"
         --file "$root/docker-compose.test.yml" --project-name "$project")
export TYPR_TEST_FAIL_AFTER_SMOKE=$failure
export TYPR_TEST_AUTH_ONLY=$auth_only
export TYPR_TEST_SUITE=$suite

cleanup() {
    result=$?
    if "${compose[@]}" down --volumes >/dev/null 2>&1; then
        printf 'run=%s suite_exit=%s cleanup=ok\n' "$project" "$result"
    else
        printf 'run=%s suite_exit=%s cleanup=failed\n' "$project" "$result" >&2
        [[ $result != 0 ]] || result=1
    fi
    exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ $suite == latency ]]; then
    printf 'run=%s fixture=sqlite gemini=unused\n' "$project"
    "${compose[@]}" run --build --rm --no-deps -T \
        -e DATABASE_URL=sqlite+pysqlite:// \
        -e JWT_SECRET=race-load-tests-only-secret-not-for-production \
        -e TYPR_POSTGRES_INTEGRATION=0 test-runner \
        python -u -m unittest backend.tests.latency.test_race_load -v
    exit
fi
printf 'run=%s fixture=postgresql16 gemini=mocked\n' "$project"
if [[ $suite == behave || ( $suite == unittest && ${TYPR_TEST_STREAM_OUTPUT:-0} == 1 ) ]]; then
    # The standalone fixture uses synthetic data; surface test output when requested.
    "${compose[@]}" up --build --abort-on-container-exit --exit-code-from test-runner
else
    "${compose[@]}" up --build --abort-on-container-exit --exit-code-from test-runner >/dev/null 2>&1
fi
